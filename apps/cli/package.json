{
  "name": "@fakeware/cli",
  "version": "0.2.1",
  "description": "Fill your Shopware 6 shop with demo data defined in typed TypeScript. Apply it with fakeware up, remove it with fakeware down.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://fakeware.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fakeware-sh/fakeware.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/fakeware-sh/fakeware/issues"
  },
  "keywords": [
    "fakeware",
    "shopware",
    "shopware6",
    "cli",
    "demo-data",
    "seed",
    "seeding",
    "fixtures",
    "test-data",
    "admin-api"
  ],
  "engines": {
    "node": ">=22.12",
    "bun": ">=1.3.14"
  },
  "bin": {
    "fakeware": "./dist/index.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./init": {
      "types": "./dist/init.d.mts",
      "import": "./dist/init.mjs"
    }
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "@fakeware/core": "^0.2.1",
    "commander": "15.0.0",
    "eta": "^4.6.0",
    "magicast": "0.5.4",
    "picocolors": "1.1.1",
    "terminal-link": "5.0.0"
  },
  "devDependencies": {
    "@fakeware/plugin-pickware": "workspace:*",
    "@types/bun": "1.3.14",
    "@types/node": "22.20.1",
    "typescript": "^6.0.3"
  }
}
