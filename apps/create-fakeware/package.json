{
  "name": "create-fakeware",
  "version": "1.2.1",
  "description": "Scaffold a Fakeware project to seed Shopware 6 demo data. Creates a typed config, an .env for your credentials, and connects to your shop.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://fakeware.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fakeware-sh/fakeware.git",
    "directory": "apps/create-fakeware"
  },
  "bugs": {
    "url": "https://github.com/fakeware-sh/fakeware/issues"
  },
  "keywords": [
    "fakeware",
    "create-fakeware",
    "shopware",
    "shopware6",
    "scaffold",
    "starter",
    "demo-data",
    "seed",
    "fixtures"
  ],
  "engines": {
    "node": ">=22.12",
    "bun": ">=1.3.14"
  },
  "bin": {
    "create-fakeware": "./dist/index.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@fakeware/cli": "^0.2.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "22.20.1"
  }
}
