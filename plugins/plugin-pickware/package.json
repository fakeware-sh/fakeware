{
  "name": "@fakeware/plugin-pickware",
  "version": "2.0.0",
  "description": "Pickware ERP plugin for fakeware. Seed bin locations, suppliers, product-supplier configurations and return orders into a Shopware 6 shop running Pickware",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fakeware-sh/fakeware.git",
    "directory": "plugins/plugin-pickware"
  },
  "keywords": [
    "fakeware",
    "fakeware-plugin",
    "shopware",
    "pickware",
    "seed",
    "fixtures"
  ],
  "engines": {
    "node": ">=22.12",
    "bun": ">=1.3.14"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "bun test"
  },
  "peerDependencies": {
    "@fakeware/core": ">=0.1.0"
  },
  "devDependencies": {
    "@fakeware/core": "workspace:*",
    "@types/bun": "1.3.14",
    "@types/node": "22.20.1"
  }
}
